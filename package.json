{
  "name": "expo-setup",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env APP_ENV=development expo start",
    "android:dev": "cross-env APP_ENV=development expo prebuild --platform android --clean && cross-env APP_ENV=development expo run:android",
    "android:release": "cross-env APP_ENV=production expo prebuild --platform android --clean && cross-env APP_ENV=production expo run:android --variant release",
    "ios:dev": "cross-env APP_ENV=development expo prebuild --platform ios --clean && cross-env APP_ENV=development expo run:ios",
    "ios:release": "cross-env APP_ENV=production expo prebuild --platform ios --clean && cross-env APP_ENV=production expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "expo-doctor": "bunx expo-doctor --verbose"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/material-symbols": "^0.4.54",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@shopify/flash-list": "2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "uniwind": "^1.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
